/* =====================================================
   OUTILS
===================================================== */

function escapeHTML(value){

    return String(value)
        .replace(
            /[&<>"']/g,
            character => ({

                "&":"&amp;",
                "<":"&lt;",
                ">":"&gt;",
                '"':"&quot;",
                "'":"&#039;"

            }[character])
        );

}


function formatSize(bytes){

    if(bytes < 1024){
        return bytes + " octets";
    }

    if(bytes < 1024 * 1024){
        return (
            (bytes / 1024).toFixed(1)
            + " Ko"
        );
    }

    return (
        (bytes / (1024 * 1024)).toFixed(1)
        + " Mo"
    );

}


function saveDocuments(){

    try{

        localStorage.setItem(
            "demoNanterreDocuments",
            JSON.stringify(documents)
        );

        return true;

    }catch(error){

        alert(
            "Le fichier est trop volumineux pour être enregistré dans le navigateur. Essaie avec un document plus léger."
        );

        return false;

    }

}



/* =====================================================
   OUVRIR UN DOCUMENT
===================================================== */

function openDocument(
    yearId,
    documentId
){

    const list =
        documents[documentId] ||
        documents[yearId] ||
        [];


    /*
       Recherche dans l'année sélectionnée.
    */

    const doc =
        list.find(
            item =>
                item.id === documentId
        );


    if(!doc){

        /*
           Sécurité supplémentaire :
           recherche globale.
        */

        let found = null;

        Object.values(
            documents
        ).forEach(
            array => {

                if(found){
                    return;
                }

                const result =
                    array.find(
                        item =>
                            item.id === documentId
                    );

                if(result){
                    found = result;
                }

            }
        );

        if(!found){

            alert(
                "Document introuvable."
            );

            return;

        }

        openDataURL(found);

        return;

    }


    openDataURL(doc);

}



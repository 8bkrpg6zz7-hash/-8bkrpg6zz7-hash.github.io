===================================================== */

function addUploadedDocument(){

    const yearSelect =
        document.getElementById(
            "adminYear"
        );

    const fileInput =
        document.getElementById(
            "adminFile"
        );


    if(
        !yearSelect ||
        !fileInput ||
        !fileInput.files.length
    ){

        alert(
            "Sélectionne d'abord un document."
        );

        return;

    }


    const yearId =
        yearSelect.value;

    const file =
        fileInput.files[0];


    /*
       Limite volontaire pour éviter de remplir
       le localStorage avec de très gros fichiers.
    */

    const maxSize =
        5 * 1024 * 1024;


    if(file.size > maxSize){

        alert(
            "Pour cette maquette, la taille maximale est de 5 Mo."
        );

        return;

    }


    const reader =
        new FileReader();


    reader.onload = function(event){

        if(!documents[yearId]){

            documents[yearId] = [];

        }


        documents[yearId].push({

            id:
                "doc-" +
                Date.now() +
                "-" +
                Math.random()
                    .toString(36)
                    .substring(2,8),

            name:
                file.name,

            type:
                file.type || "Document",

            size:
                file.size,

            data:
                event.target.result

        });


        if(
            saveDocuments()
        ){

            fileInput.value = "";

            const preview =
                document.getElementById(
                    "filePreview"
                );

            if(preview){

                preview.textContent =
                    "Document ajouté à la maquette.";

            }

            renderAdminDocuments();

        }

    };


    reader.readAsDataURL(file);

}


